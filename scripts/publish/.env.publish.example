# TikTok publisher config — copy this file to scripts/publish/.env.publish.local and fill in.
# .env.publish.local is gitignored. NEVER commit real values. NEVER paste them into chat.

# From your TikTok developer app (developers.tiktok.com → your app → credentials):
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must EXACTLY match a redirect URI registered on the app's Desktop platform.
# TikTok allows http on 127.0.0.1 / localhost for Desktop apps (https is required only for Web apps).
TIKTOK_REDIRECT_URI=http://127.0.0.1:8787/callback

# The three below are written automatically by `npm run tiktok-auth` — leave blank.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_EXPIRES=
