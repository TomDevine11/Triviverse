{
  "name": "football501",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build && node scripts/prerender.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "seo-report": "node scripts/seo/report.mjs",
    "analytics-report": "node scripts/seo/ga4.mjs",
    "search-console-report": "node scripts/seo/gsc.mjs",
    "seo-suggest": "node scripts/seo/suggest.mjs",
    "growth-discover": "node scripts/seo/growth/discover.mjs",
    "scrape:pl-history": "node scripts/pl-history/scrape.mjs",
    "scrape:intl": "node scripts/pl-history/scrape-intl.mjs",
    "build:intl": "node scripts/pl-history/build-intl.mjs",
    "scrape:transfers": "node scripts/pl-history/scrape-transfers.mjs",
    "build:transfers": "node scripts/build-transfers.mjs",
    "scrape:honours": "node scripts/pl-history/scrape-honours.mjs",
    "build:pl-positions": "node scripts/pl-history/positions.mjs",
    "build:pl-clubnames": "node scripts/pl-history/clubnames.mjs",
    "clubnames:all": "for c in ES1 IT1 FR1 L1 CL; do COMP=$c node scripts/pl-history/clubnames.mjs; done",
    "build:pl-history": "node scripts/pl-history/build-facts.mjs",
    "build:canonical": "node scripts/build-canonical.mjs",
    "build:squads": "node scripts/pl-history/build-squads.mjs",
    "build:teammates": "node scripts/build-teammates.mjs",
    "build:recognisability": "node scripts/build-recognisability.mjs",
    "build:categories": "node scripts/build-categories.mjs",
    "build:pl-catalog": "node scripts/pl-history/build-intl.mjs && node scripts/build-canonical.mjs && node scripts/build-honours.mjs && node scripts/pl-history/build-squads.mjs && node scripts/build-transfers.mjs && node scripts/build-recognisability.mjs && node scripts/build-categories.mjs && node scripts/build-teammates.mjs && node scripts/pl-history/build-catalog.mjs && node scripts/build-leaderboards.mjs && node scripts/build-tenable.mjs && node scripts/build-indexes.mjs && node scripts/build-signings.mjs",
    "build:stats": "node scripts/build-leaderboards.mjs",
    "build:tenable": "node scripts/build-tenable.mjs",
    "scrape:all": "for c in ES1 L1 IT1 FR1 CL; do COMP=$c node scripts/pl-history/scrape.mjs && COMP=$c node scripts/pl-history/build-facts.mjs; done",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:honours": "node scripts/build-honours.mjs",
    "build:signings": "node scripts/build-signings.mjs",
    "build:indexes": "node scripts/build-indexes.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google-analytics/data": "^6.1.0",
    "@googleapis/searchconsole": "^6.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "google-auth-library": "^10.9.1",
    "postcss": "^8.5.14",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
