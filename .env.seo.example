# ─────────────────────────────────────────────────────────────────────────
# SEO intelligence layer config. Copy to .env.seo.local (gitignored) and fill
# in what you have. Every source is optional — the layer degrades gracefully.
# Full walkthrough: scripts/seo/SETUP.md
# ─────────────────────────────────────────────────────────────────────────

# ── Priority 1: Google (GA4 Data API + Search Console) ──────────────────────
# One service account authenticates BOTH. Put its JSON key at
# scripts/seo/.secrets/service-account.json (the default the layer looks for),
# or set GOOGLE_APPLICATION_CREDENTIALS to its path, or paste it inline below.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GA_SERVICE_ACCOUNT_JSON=            # inline JSON or base64 (handy for CI)

GA4_PROPERTY_ID=                      # numeric property id, e.g. 480123456 (NOT the G-XXXX measurement id)
GSC_SITE_URL=                         # 'https://triviverse.com/'  OR  'sc-domain:triviverse.com'

# ── Priority 2 ──────────────────────────────────────────────────────────────
BING_API_KEY=                         # Bing Webmaster Tools → Settings → API access
BING_SITE_URL=https://triviverse.com
CLARITY_API_TOKEN=                    # Clarity → Settings → Data Export → generate API token

# ── Priority 3: keyword search volume (recommended: DataForSEO) ──────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Defaults ────────────────────────────────────────────────────────────────
SEO_LOOKBACK_DAYS=90
# SEO_COUNTRY=gbr                     # optional ISO-3 country filter
